<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIUNLOCK"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TextMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="точное время по NTP, снайпер подачи заявки на разблокировку загрузчика" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Время" />

                <TextView
                    android:id="@+id/textClock"
                    style="@style/TextClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--:--.---" />

                <TextView
                    android:id="@+id/textClockZones"
                    style="@style/TextMono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:text="Пекин --:--:--   МСК --:--:--" />

                <TextView
                    android:id="@+id/textNtpStatus"
                    style="@style/TextMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="нет синхронизации" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Синхронизировать NTP" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Цель" />

                <RadioGroup
                    android:id="@+id/radioTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioBeijing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:text="00:00 Пекин (UTC+8) — момент сброса квоты" />

                    <RadioButton
                        android:id="@+id/radioMsk1900"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:text="19:00 МСК — то же самое в московском времени" />

                    <RadioButton
                        android:id="@+id/radioMsk1700"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:text="17:00 МСК" />

                    <RadioButton
                        android:id="@+id/radioCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:text="своё время" />

                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonPickTarget"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Задать своё время" />

                <TextView
                    android:id="@+id/textTargetInfo"
                    style="@style/TextMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="цель не задана" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Снайпер" />

                <TextView
                    android:id="@+id/textCountdown"
                    style="@style/TextCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--:--.---" />

                <TextView
                    android:id="@+id/textPhase"
                    style="@style/TextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="состояние: ожидание" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonArm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ARM" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDisarm"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Снять" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Аккаунт Xiaomi" />

                <TextView
                    android:id="@+id/textAccount"
                    style="@style/TextMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="вход не выполнен" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonLogin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Вход" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCheckState"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Проверить статус" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тайминг" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NumberField"
                        android:hint="опережение, мс">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputEarly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NumberField"
                        android:layout_marginStart="8dp"
                        android:hint="прогрев, мс">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPreconnect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NumberField"
                        android:hint="разброс от, мс">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputJitterMin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NumberField"
                        android:layout_marginStart="8dp"
                        android:hint="разброс до, мс">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputJitterMax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NumberField"
                        android:hint="окно повторов, мс">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputRetryWindow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NumberField"
                        android:layout_marginStart="8dp"
                        android:hint="интервал, мс">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputRetryInterval"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NumberField"
                        android:hint="попыток">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputAttempts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/NumberField"
                        android:layout_marginStart="8dp"
                        android:hint="подготовка, с">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPrepare"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/NumberField"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:hint="NTP-серверы">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputServers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonApplySettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Применить" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Журнал" />

                <ScrollView
                    android:id="@+id/scrollLog"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@color/surface_variant"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/textLog"
                        style="@style/TextMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />

                </ScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonClearLog"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Очистить журнал" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="16dp"
            android:text="Приложение обращается только к NTP-серверам и хостам Xiaomi. Телеметрии нет, данные аккаунта хранятся в шифрованном виде на устройстве." />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
